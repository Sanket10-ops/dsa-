class Solution {
    public int numTrees(int n) {
        // dp[i] stores the number of unique BSTs with i nodes
        int[] dp = new int[n + 1];
        
        // Base cases
        dp[0] = 1; // Empty tree is 1 valid BST structure
        dp[1] = 1; // Single node tree is 1 valid BST structure
        
        // Fill DP table for nodes 2 to n
        for (int i = 2; i <= n; i++) {
            for (int j = 1; j <= i; j++) {
                // j is chosen as root
                // j - 1 nodes go to left subtree
                // i - j nodes go to right subtree
                dp[i] += dp[j - 1] * dp[i - j];
            }
        }
        
        return dp[n];
    }
}
