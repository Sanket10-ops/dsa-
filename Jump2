class Solution {
    public int jump(int[] nums) {
        //If the array has only 1 element, we are already at the last index.
        if (nums.length <= 1) return 0;

        int jumps = 0;
        int currentMax = 0; 
        int nextMax = 0;
            nextMax = Math.max(nextMax, i + nums[i]);

            // If we have reached the end of the current jump, 
            // we MUST take a jump.
            if (i == currentMax) {
                jumps++;
                currentMax = nextMax;
            }
        }

        return jumps;
    }
}
