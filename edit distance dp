class Solution {
    public int minDistance(String word1, String word2) {
        int m = word1.length();
        int n = word2.length();
        
        // Base case: to convert word1 to empty word2, delete all characters
        if (n == 0) return m;
        if (m == 0) return n;

        // DP table for the current and previous row
        int[] dp = new int[n + 1];

        // Initialize base case for matching empty prefix of word1 with word2
        for (int j = 0; j <= n; j++) {
            dp[j] = j;
        }

        for (int i = 1; i <= m; i++) {
            int prevDiagonal = dp[0]; // Stores dp[i-1][j-1]
            dp[0] = i; // Base case: converting word1[0..i] to empty string requires i deletions

            for (int j = 1; j <= n; j++) {
                int temp = dp[j]; // Store current dp[j] before updating (it becomes prevDiagonal for j+1)
                
                if (word1.charAt(i - 1) == word2.charAt(j - 1)) {
                    dp[j] = prevDiagonal;
                } else {
                    dp[j] = 1 + Math.min(prevDiagonal, // Replace
                                Math.min(dp[j],       // Delete
                                         dp[j - 1])); // Insert
                }
                
                prevDiagonal = temp;
            }
        }

        return dp[n];
    }
}
